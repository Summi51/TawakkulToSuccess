// Flatten Array

const arr = [1, 2, [3, [6, 7]], 3, 5, 2]

// flatten this array but not used flat method ??
// expected output: [1,2,3,6,7,3,5,2]


function fn(arr){
     let store = []

       for(let i=0; i<arr.length; i++){
        if(Array.isArray(arr[i])){
            let value = fn(arr[i]); 

        for(let j=0; j<value.length;  j++){
                store.push(value[j])
            }
        } else{
         store.push(arr[i])
        }
       }

       return store;
}
console.log(fn(arr))


